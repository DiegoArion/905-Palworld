[Unit]
Description=Palworld Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta el usuario y la ruta al proyecto en tu servidor Ubuntu
User=palworldbot
WorkingDirectory=/home/palworldbot/palworld-discord-bot
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
