# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Canal aparte donde el bot mantiene un unico mensaje "dashboard" que va editando (opcional)
DISCORD_DASHBOARD_CHANNEL_ID=
# Canal de logs: solo estado del servidor (online/offline) y capturas de Pals
DISCORD_LOGS_CHANNEL_ID=

# --- Dathost (cuenta) ---
DATHOST_EMAIL=
DATHOST_PASSWORD=
DATHOST_SERVER_ID=

# --- REST API de Palworld (docs.palworldgame.com/category/rest-api) ---
# Host/puerto: en Dathost es el mismo host del server y el puerto "rest_api"
# que aparece en `npm run list-servers` (campo ports.rest_api).
# Password: la "Admin Password" del server (pestaña Settings en Dathost).
PALWORLD_API_HOST=
PALWORLD_API_PORT=8212
PALWORLD_API_PASSWORD=

# --- Intervalos de polling (ms) ---
CONSOLE_POLL_INTERVAL_MS=8000
PLAYER_POLL_INTERVAL_MS=20000
STATUS_POLL_INTERVAL_MS=60000
DASHBOARD_POLL_INTERVAL_MS=90000

# --- Leaderboard automático ---
# Expresion cron (hora del servidor). Por defecto: todos los dias a las 21:00
LEADERBOARD_CRON=0 21 * * *
LEADERBOARD_TIMEZONE=America/Mexico_City

# --- Ruta de la base de datos SQLite ---
DB_PATH=./data/playtime.db
